@charset "utf-8";

.form-checkbox { color: rgb(204, 204, 204); cursor: pointer; display: block; overflow: hidden; padding: 7px 25px 8px 0px; position: relative; text-decoration: none !important; }

.form-checkbox_wrap { padding: 5px 0px; }

.form-checkbox_btn { inset: 0px; position: absolute; }

.form-checkbox.left_chb { padding: 7px 0px 8px 25px; }

.form-checkbox.left_chb.form-checkbox__drag { padding: 7px 25px 8px; }

.form-checkbox__group { margin-bottom: -8px; }

.form-checkbox__drag_btn { bottom: 0px; position: absolute; right: 0px; top: 0px; width: 46px; }

.form-checkbox.left_chb::after, .s-chb.left_chb::after { left: 0px; right: auto; }

.form-checkbox__descr { color: rgb(204, 204, 204); margin-top: 5px; }

.form-checkbox_checked .form-checkbox__descr { color: rgb(255, 255, 255); font-weight: 400; }

.f-c_fll .form-checkbox.right_chb, .form-checkbox_full.right_chb, .full_height .form-checkbox_full { padding: 13px 46px 12px 15px; }

.f-c_fll .form-checkbox, .form-checkbox_full { border-bottom: 1px solid rgb(45, 46, 48); padding: 13px 15px 12px 40px; }

.f-c_fll .form-checkbox.left_chb.form-checkbox__drag { padding: 13px 46px 12px; }

.f-c_fll_ns .form-checkbox { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.f-c_fll .error__item .form-checkbox { border-bottom: 0px; }

.error__msg.error__msg_chb { padding: 0px 15px 11px; }

.group .form-checkbox_full { border-bottom: 0px; }

.form-checkbox_no-after::after { display: none; }

.f-c_fll .form-checkbox::after, .form-checkbox_full::after { left: 15px; }

.f-c_fll .form-checkbox.right_chb::after, .form-checkbox_dropdown-menu::after, .form-checkbox_full.right_chb::after, .full_height .form-checkbox_full::after, .s-chb::after, .sep-chb .form-checkbox::after { left: auto; right: 15px; }

.form-checkbox_w_descr::after { margin-top: 13px; top: 0px; }

.form-checkbox_w_descr .form-checkbox__label { color: rgb(255, 255, 255); }

.form-checkbox__el_fix { left: auto; right: 12px; }

.form-checkbox_checked { color: rgb(255, 255, 255) !important; font-weight: 700; }

.full_height, .full_height .form-checkbox { inset: 0px; position: absolute; z-index: 10; }

.full_height_side, .full_height_side .form-checkbox { left: auto; }

.form-checkbox .mysite-nick { color: rgb(255, 255, 255); font-weight: 700; }

.form-checkbox, .form-toggle__wrap { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); user-select: none; }

.form-checkbox_dropdown-menu, .sep-chb .form-checkbox { background: rgb(62, 63, 64); border-bottom: 1px solid rgb(45, 46, 48); padding: 13px 15px 12px; }

.form-checkbox_dropdown-menu { padding: 13px 46px 12px 15px; }

.dropdown-menu_access .form-checkbox_dropdown-menu { padding: 15px; }

.links-group_short .dropdown-menu_access .form-checkbox_dropdown-menu { padding: 10px 15px; }

.form-checkbox_dropdown-menu:last-child, .sep-chb .form-checkbox:last-child { border-bottom: 0px; }

.form-checkbox_dropdown-menu:active, .sep-chb .form-checkbox:active { color: rgb(255, 255, 255); }

.form-checkbox-native .form-checkbox::after { display: none; }

.form-checkbox-native .form-checkbox__el { left: auto; position: static; }

.user__tools_horiz-mode { border: 1px solid rgb(40, 40, 42); border-radius: 3px; }

.user__tools_horiz-mode .clicked::after { display: none !important; }

.user__tools_horiz-mode .user__tools-link { font-weight: 400; min-height: 18px; padding: 11px 0px; }

.user__tools_horiz-mode .table__cell { border-right: 1px solid rgb(40, 40, 42); }

.user__tools_horiz-mode .user__tools-link.clicked, .user__tools_horiz-mode .user__tools-link:active { padding: 12px 0px 10px; }

.user__tools_horiz-mode .table__cell.table__cell_last { border-right: 0px; }

.user__tools_horiz-mode .user__tools-link--with-description.clicked { position: relative; }

.user__tools_horiz-mode .user__tools-link--with-description.clicked::after { border-bottom-color: rgb(75, 77, 78); margin-top: -8px; display: block !important; }

.user__tools_horiz-description { background: rgb(75, 77, 78); color: rgb(204, 204, 204); margin-top: 10px; padding: 10px; position: relative; }

.form-toggle__wrap { background: rgb(96, 169, 117); border-radius: 4px; box-shadow: rgb(39, 119, 62) 0px 3px 5px inset; cursor: pointer; display: block; height: 20px; position: relative; transition: background 0.5s; width: 34px; z-index: 10; }

.form-toggle__wrap_off { background: rgb(133, 133, 133); box-shadow: rgb(79, 79, 79) 0px 3px 5px inset; }

.form-toggle__wrap::after { background: rgb(255, 255, 255); border-radius: 4px; box-shadow: rgba(17, 17, 19, 0.3) 0px 3px 3px; content: ""; cursor: pointer; display: block; height: 16px; left: 16px; position: absolute; top: 2px; transition: left 0.5s; width: 16px; z-index: 500; }

.form-toggle__wrap_off::after { left: 2px; }

.soc-link { border-radius: 2px; color: rgb(255, 255, 255); display: inline-block; height: 18px; margin: 0px 8px 15px; padding: 12px; vertical-align: middle; width: 18px; }

.soc-link:active { padding: 13px 12px 11px; }

.soc-link__wrapper { margin-bottom: -10px; text-align: center; }

.soc-link__wrapper .soc-link { display: inline-block; margin: 0px 6px 10px; padding: 6px; }

.soc-link__wrapper .soc-link:active { padding: 7px 6px 5px; }

