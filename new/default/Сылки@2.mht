------MultipartBoundary--ir9Uf6kddSjVQy5VE2qvZLRZF1MRP2cR46NexJP0qF----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://spaces.im/css/custom/dark/touch/b/main.css?0c8ffc51c

@charset "utf-8";

html { text-size-adjust: 100%; }

button, input, optgroup, select, textarea { line-height: 1.15; }

button, h1, h2, h3, h4, h5, h6, input, optgroup, p, select, table, td, textarea, th, tr { font-family: inherit; font-size: 100%; }

:root { color-scheme: dark only; }

body, html { background: rgb(0, 0, 0); color: rgb(255, 255, 255); font-weight: 400; margin: 0px auto; max-width: 100%; position: relative; text-align: left; touch-action: manipulation; width: auto; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); }

body, button, html, textarea { font-family: Helvetica, Arial, "lucida grande", tahoma, verdana, arial, sans-serif; }

body { min-height: 100vh; }

uc-click { cursor: pointer; display: inline; }

h1, h2, h3, h4, h5, h6, p { border: 0px; font-weight: inherit; margin: 0px; padding: 0px; }

textarea { overflow: auto; }

a { text-decoration: none !important; }

a img { border: 0px; }

li, ol, ul { margin: 0px; padding: 0px; }

ol, ul { padding-left: 20px; }

input[type="file"] { max-width: 100%; }

iframe { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; box-shadow: none; }

select { max-width: 90%; }

:focus { outline: none; }

.button, button, input[type="button"], input[type="reset"], input[type="submit"] { background: rgb(62, 63, 64); border: 1px solid rgb(40, 40, 42); border-radius: 4px; color: rgb(255, 255, 255); cursor: pointer; outline: 0px; }

.button:active, button:active, input[type="button"]:active, input[type="reset"]:active, input[type="submit"]:active { background-color: rgb(85, 87, 89); }

::placeholder { color: rgb(152, 159, 164); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

::-webkit-input-placeholder { color: rgb(152, 159, 164); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

input[disabled]::placeholder { color: rgb(152, 159, 164); }

input[disabled]::-webkit-input-placeholder { color: rgb(152, 159, 164); }

textarea::placeholder { white-space: normal; }

textarea::-webkit-input-placeholder { white-space: normal; }

.fixed-size { display: inline-block; position: relative; width: 100%; }

.fixed-size::before { content: ""; display: block; }

.fixed-size--1-1::before { padding-top: 100%; }

.fixed-size-16-9::before { padding-top: 56.25%; }

.fixed-size__content { inset: 0px; position: absolute; }

.icon-secondary-color { color: rgb(204, 204, 204); }

.icon-accent-color, .icon-primary-color { color: rgb(124, 195, 255); }

.yellow { color: rgb(255, 160, 0); }

.red { color: rgb(255, 138, 102); }

.purple { color: rgb(181, 145, 235); }

.green { color: rgb(120, 217, 147); }

body .link-red { color: rgb(255, 138, 102); }

body .link-green { color: rgb(120, 217, 147); }

.mysite-nick, .un { color: rgb(204, 204, 204); }

.mysite-nick--frozen { color: rgb(136, 136, 136); }

.mysite-nick--blocked { text-decoration: line-through; }

.darkgreen { color: rgb(120, 217, 147); }

.f897dfb86b10, .gl a, .grey, .link-dim, .link-normal, .text-gray, .text_normal, body .link-grey { color: rgb(204, 204, 204); }

.lightgrey { color: rgb(121, 122, 122); }

.black, .white { color: rgb(255, 255, 255); }

.blue_text { color: rgb(124, 195, 255); }

.wbg { background: rgb(62, 63, 64) !important; }

.transpar { background: none !important; }

.darkred, body .link-darkred { color: rgb(255, 138, 102); }

.capitalize { text-transform: capitalize; }

.lowercase { text-transform: lowercase; }

.upcs { text-transform: uppercase; }

#siteContent { position: relative; }

.main { background: rgb(45, 46, 48); }

.error { color: rgb(255, 255, 255); }

.anketa__rate-link, .bc1b4461, .blog-item__title, .darkblue, .drop-down-label.drop-down-label_spoiler, .edit_widget_title, .f_descr_text, .info-item__descr a, .info-item__descr-link, .inl-link, .link-darkblue, .link-stnd, .list-link__name, .nl a, .response, .sub_menu a, .text-title, .url-btn, a, a.arrow_link span { color: rgb(124, 195, 255); }

.cl, .clear, hr { clear: both; }

hr { border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(197, 211, 225); border-image: initial; margin-bottom: 10px; margin-top: 10px; }

.busi_switcher table a, .busi_switcher table td, .fdw, .menu_wrap, .oh relative, .relative { position: relative; }

.preview--stub { background: rgb(78, 79, 80); }

.preview-guard { inset: 0px; display: block; height: 100%; position: absolute; width: 100%; z-index: 1000; }

.cf::after, .cf::before { content: "."; display: block; height: 0px; overflow: hidden; }

.cf::after { clear: both; }

.font0 { font-size: 0px; }

.font_small { font-size: 11px; }

.block_hr { border-bottom: 1px dotted rgb(45, 46, 48); }

.list_item { overflow-wrap: break-word; border-bottom: 1px solid rgb(45, 46, 48); }

