.soc-link_spcs:hover { background: rgb(68, 90, 136) !important; }

.soc-link_spcs:active { background: rgb(60, 78, 119) !important; }

.soc-link_spcs:active, body #left_nav ul li .soc-link_spcs:active { box-shadow: rgb(22, 29, 44) 0px 3px 5px inset; }

.soc-link_mymir { background: rgb(22, 141, 226); }

.soc-link_mymir:hover { background: rgb(1, 112, 191) !important; }

.soc-link_mymir:active { background: rgb(0, 90, 155) !important; }

.soc-link_mymir:active, body #left_nav ul li .soc-link_mymir:active { box-shadow: rgb(0, 35, 73) 0px 3px 5px inset; }

.soc-link_email { background: rgb(82, 82, 82); }

.soc-link_email:hover { background: rgb(64, 64, 64) !important; }

.soc-link_email:active { background: rgb(32, 32, 32) !important; }

.soc-link_email:active, body #left_nav ul li .soc-link_email:active { box-shadow: rgb(1, 16, 48) 0px 3px 5px inset; }

.soc-link_fb { background: rgb(67, 96, 156); }

.soc-link_fb:hover { background: rgb(22, 80, 197) !important; }

.soc-link_fb:active { background: rgb(9, 35, 88) !important; }

.soc-link_fb:active, body #left_nav ul li .soc-link_fb:active { box-shadow: rgb(1, 16, 48) 0px 3px 5px inset; }

.soc-link_google { background: rgb(215, 61, 50); }

.soc-link_google:hover { background: rgb(174, 12, 0) !important; }

.soc-link_google:active { background: rgb(124, 0, 0) !important; }

.soc-link_google:active, body #left_nav ul li .soc-link_google:active { box-shadow: rgb(79, 0, 0) 0px 3px 5px inset; }

#left_nav ul li a.inl-link { display: inline; background: none !important; padding: 0px !important; }

.soc-link_yandex { background: rgb(252, 63, 29); }

.soc-link_yandex:hover { background: rgb(211, 34, 3) !important; }

.soc-link_yandex:active { background: rgb(176, 29, 3) !important; }

.soc-link_yandex:active, body #left_nav ul li .soc-link_yandex:active { box-shadow: rgb(75, 12, 1) 0px 3px 5px inset; }

.soc-link_tg { background: rgb(84, 169, 235); }

.soc-link_tg:hover { background: rgb(59, 140, 203) !important; }

.soc-link_tg:active { background: rgb(21, 110, 178) !important; }

.soc-link_tg:active, body #left_nav ul li .soc-link_tg:active { box-shadow: rgb(6, 31, 50) 0px 3px 5px inset; }

.soc-link_inst { background: rgb(228, 64, 95); }

.soc-link_inst:hover { background: rgb(204, 45, 75) !important; }

.soc-link_inst:active { background: rgb(158, 31, 54) !important; }

